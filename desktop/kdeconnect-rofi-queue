import argparse
import json
import shutil
import subprocess
import sys
import time
import uuid


def pick(prompt, labels):
    result = subprocess.run(
        ["rofi", "-dmenu", "-no-custom", "-format", "i", "-p", prompt],
        input="\n".join(" ".join(label.split()) for label in labels) + "\n",
        text=True, stdout=subprocess.PIPE, check=False,
    )
    if result.returncode == 1:
        return None
    result.check_returncode()
    index = int(result.stdout.strip())
    if not 0 <= index < len(labels):
        raise ValueError("Rofi returned an invalid selection.")
    return index


def main():
    parser = argparse.ArgumentParser(description="Play a track from a paired phone's music queue.")
    parser.add_argument("device_id", help="KDE Connect device ID from kdeconnect-cli --list-available")
    parser.add_argument("--player", help="Select the Android media player by its KDE Connect name")
    args = parser.parse_args()
    path = f"/modules/kdeconnect/devices/{args.device_id}/mprisremote"
    interface = "org.kde.kdeconnect.device.mprisremote"
    bus = ["busctl", "--user", "--json=short", "--timeout=3"]
    destination = ["org.kde.kdeconnect", path, interface]

    def dbus(*arguments):
        result = subprocess.check_output([*bus, *arguments], text=True)
        return json.loads(result)["data"] if result.strip() else None

    def exchange(method, player, *extra):
        request_id = uuid.uuid4().hex
        dbus("call", *destination, method, "s" * (2 + len(extra)), player, request_id, *extra)
        deadline = time.monotonic() + 4
        while time.monotonic() < deadline:
            reply, = dbus("call", *destination, "musicQueueReply", "s", request_id)
            if reply:
                return json.loads(reply)
            time.sleep(0.1)
        raise ValueError("The phone did not return a queue reply. Check pairing and the Android fork version.")

    player = args.player
    if player is None:
        players = dbus("get-property", *destination, "playerList")
        if not players:
            raise ValueError("No active music player on the paired phone.")
        index = 0 if len(players) == 1 else pick("Phone player", players)
        if index is None:
            return
        player = players[index]

    queue = exchange("requestMusicQueue", player)
    if not queue["available"]:
        raise ValueError(f"{player} does not expose a playback queue.")
    entries = queue["entries"]
    if not entries:
        raise ValueError("The phone's playback queue is empty.")

    labels = []
    for entry in entries:
        marker = "▶ " if entry["id"] == queue["activeId"] else ""
        title = entry["title"] or "Untitled track"
        artist = f" — {entry['artist']}" if entry["artist"] else ""
        labels.append(f"{marker}{title}{artist}")

    selectable = queue["canSelect"]
    index = pick("Phone queue" if selectable else "Phone queue (read only)", labels)
    if index is not None and selectable:
        reply = exchange("selectMusicQueueItem", player, queue["token"], entries[index]["id"])
        if not reply["accepted"]:
            raise ValueError("The queue changed or the player no longer supports selection. Reopen the picker.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        print(error, file=sys.stderr)
        if shutil.which("rofi"):
            subprocess.run(["rofi", "-e", str(error)], check=False)
        raise SystemExit(1)
