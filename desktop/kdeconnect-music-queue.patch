         return;

+    if (np.has(QStringLiteral("queueRequestId"))) {
+        if (np.get<QString>(QStringLiteral("queueRequestId")) == m_queueRequestId
+            && np.get<QString>(QStringLiteral("player")) == m_queueRequestPlayer) {
+            m_queueReply = np.get<QString>(QStringLiteral("queueReply"));
+        }
+        return;
+    }
+
     if (np.get<bool>(QStringLiteral("transferringAlbumArt"), false)) {
         AlbumArtCache::instance()->handleAlbumArt(np);
         return;
