 }

+void MprisRemotePlugin::requestMusicQueue(const QString &player, const QString &requestId)
+{
+    m_queueRequestId = requestId;
+    m_queueRequestPlayer = player;
+    m_queueReply.clear();
+    NetworkPacket np(PACKET_TYPE_MPRIS_REQUEST, {{QStringLiteral("player"), player}, {QStringLiteral("queueRequestId"), requestId}});
+    sendPacket(np);
+}
+
+void MprisRemotePlugin::selectMusicQueueItem(const QString &player, const QString &requestId, const QString &token, const QString &itemId)
+{
+    m_queueRequestId = requestId;
+    m_queueRequestPlayer = player;
+    m_queueReply.clear();
+    NetworkPacket np(PACKET_TYPE_MPRIS_REQUEST,
+                     {{QStringLiteral("player"), player},
+                      {QStringLiteral("queueRequestId"), requestId},
+                      {QStringLiteral("queueToken"), token},
+                      {QStringLiteral("queueItemId"), itemId}});
+    sendPacket(np);
+}
+
+QString MprisRemotePlugin::musicQueueReply(const QString &requestId) const
+{
+    return requestId == m_queueRequestId ? m_queueReply : QString();
+}
+
 void MprisRemotePlugin::requestPlayerList()
 {
